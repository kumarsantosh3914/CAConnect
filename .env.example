# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard  (create a project in ap-south-1)
# ---------------------------------------------------------------------------
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Settings → API → service_role. SERVER ONLY. Never expose to the browser.
# Used in exactly one place: app/api/upload/[token]/ for anonymous client uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Chosen by benchmark, not by default — see scripts/compare-models.mts and
# `npm run compare-models`. Across three notice types, gpt-5.6-sol was the only
# model to score 5/5 on both register and carrying through the facts the notice
# supplies, repeatably. Costs ~7% of a Solo subscription at 20 drafts a month.
#
# Cheaper levers if that ever matters: gpt-5.6-luna is ~17x cheaper and scores
# 4/5, gpt-5.4-mini is 4x faster but noticeably thinner in substance.
OPENAI_MODEL=gpt-5.6-sol

# ---------------------------------------------------------------------------
# Resend — https://resend.com  (needed from Week 6, deadline reminder emails)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="CAConnect <reminders@yourdomain.in>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build the client-facing document upload links. No trailing slash.
#
# On Vercel you can LEAVE THIS UNSET: the app falls back to Vercel's stable
# production domain, so upload links are correct on the first deploy. Set it
# only once you have a custom domain — an explicit value always wins.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret guarding app/api/cron/reminders. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ---------------------------------------------------------------------------
# WhatsApp Business — Meta Cloud API  (V2; OFF until Meta approves)
# ---------------------------------------------------------------------------
# The integration ships switched off and stays that way until Meta has both
# verified the business AND approved the message templates. Sending before then
# fails on every message, so the flag below is separate from the credentials on
# purpose: having keys present is never enough to start messaging real clients.
#
# Setup order, because it matters:
#   1. Meta Business Manager → verify the business. This is the long pole;
#      start it early, it can take days to weeks.
#   2. Add a WhatsApp product, register a phone number, note its Phone Number ID.
#   3. Submit BOTH templates for approval, in the 'utility' category, with the
#      exact body text in lib/whatsapp/templates.ts:
#          deadline_reminder   (5 parameters)
#          document_request    (5 parameters)
#      Changing a word there without re-submitting here breaks every send.
#   4. Set the webhook callback to https://<your-domain>/api/webhooks/whatsapp
#      with the verify token below. The webhook works independently of the
#      send flag, so you can complete this step before going live.
#   5. Only then set WHATSAPP_ENABLED=true.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Any random string; Meta echoes it back when you save the callback URL.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WHATSAPP_VERIFY_TOKEN=
# Meta app dashboard → App Settings → Basic → App Secret. This signs every
# webhook callback and is the only thing authenticating them.
WHATSAPP_APP_SECRET=
# Pin only if you need an older Graph API version.
# WHATSAPP_API_VERSION=v21.0
