# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard  (create a project in ap-south-1)
# ---------------------------------------------------------------------------
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Settings → API → service_role. SERVER ONLY. Never expose to the browser.
# Used in exactly one place: app/api/upload/[token]/ for anonymous client uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Balanced intelligence/cost tier. Swap for a higher or cheaper tier without
# touching code. Verify current model ids at https://developers.openai.com/api/docs/models
OPENAI_MODEL=gpt-5.6-terra

# ---------------------------------------------------------------------------
# Resend — https://resend.com  (needed from Week 6, deadline reminder emails)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="CAConnect <reminders@yourdomain.in>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build the client-facing document upload links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret guarding app/api/cron/reminders. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
