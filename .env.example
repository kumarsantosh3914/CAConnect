# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard  (create a project in ap-south-1)
# ---------------------------------------------------------------------------
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Settings → API → service_role. SERVER ONLY. Never expose to the browser.
# Used in exactly one place: app/api/upload/[token]/ for anonymous client uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# OpenAI — https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Chosen by benchmark, not by default — see scripts/compare-models.mts and
# `npm run compare-models`. Across three notice types, gpt-5.6-sol was the only
# model to score 5/5 on both register and carrying through the facts the notice
# supplies, repeatably. Costs ~7% of a Solo subscription at 20 drafts a month.
#
# Cheaper levers if that ever matters: gpt-5.6-luna is ~17x cheaper and scores
# 4/5, gpt-5.4-mini is 4x faster but noticeably thinner in substance.
OPENAI_MODEL=gpt-5.6-sol

# ---------------------------------------------------------------------------
# Resend — https://resend.com  (needed from Week 6, deadline reminder emails)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="CAConnect <reminders@yourdomain.in>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build the client-facing document upload links. No trailing slash.
#
# On Vercel you can LEAVE THIS UNSET: the app falls back to Vercel's stable
# production domain, so upload links are correct on the first deploy. Set it
# only once you have a custom domain — an explicit value always wins.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret guarding app/api/cron/reminders. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
